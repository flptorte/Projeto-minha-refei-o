<mxfile host="Electron">
  <diagram name="Página-1" id="96DJ_JvB68v9bR5If3Kr">
    <mxGraphModel dx="3142" dy="1869" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% --- 1. FRONTEIRAS (BOUNDARIES) ---\n    class InterfaceAssinatura {\n        &lt;&lt;boundary&gt;&gt;\n        +exibeTelaCodigo() void\n        +exibePlanosDisponiveis() void\n        +exibeCardapio(itens: List) void\n        +atualizaResumoPedido() void\n        +exibeErro(msg: String, tentativasRestantes: Integer) void\n        +exibeErroPagamento(msg: String) void\n        +exibeConfirmacao(protocolo: String, dataEntrega: Date) void\n    }\n\n    class ServicoSMS {\n        &lt;&lt;boundary&gt;&gt;\n        +enviarSMS(telefone: String, codigo: String) Boolean\n    }\n\n    class OperadoraCartaoCredito {\n        &lt;&lt;boundary&gt;&gt;\n        +solicitarAutorizacao(dadosCartao: DadosCartao, valor: Decimal) RespostaAutorizacao\n    }\n\n    %% --- 2. CONTROLADOR (CONTROLLER) ---\n    class cAssinatura {\n        &lt;&lt;control&gt;&gt;\n        +solicitarCodigoSMS(telefone: String) void\n        +validarCodigo(codigo: String) Boolean\n        +escolherPlano(idPlano: Integer) void\n        +registrarPreferencias(tipoDieta: String) void\n        +adicionarItem(idItem: Integer, quantidade: Integer) void\n        +registrarEnderecoEntrega(dadosEndereco: DadosEndereco) void\n        +finalizarAssinatura(dadosCartao: DadosCartao) Boolean\n    }\n\n    %% --- 3. COLEÇÃO (COLLECTION) ---\n    class Collection_PlanoAssinatura {\n        &lt;&lt;collection&gt;&gt;\n        +getPlano(idPlano: Integer) PlanoAssinatura\n        +listarPlanosAtivos() List~PlanoAssinatura~\n    }\n\n    %% --- 4. ENTIDADES (ENTITIES) ---\n    class Assinante {\n        &lt;&lt;entity&gt;&gt;\n        -telefone: String\n        -nome: String\n        -email: String\n        +buscaOuCria(telefone: String) Assinante\n        +setPreferenciaAlimentar(tipo: String) void\n        +setEndereco(endereco: Endereco) void\n    }\n\n    class ValidacaoSMS {\n        &lt;&lt;entity&gt;&gt;\n        -codigo: String\n        -dataHoraEnvio: DateTime\n        -dataHoraExpiracao: DateTime\n        -quantidadeTentativas: Integer\n        -validado: Boolean\n        +validar(codigoInformado: String) Boolean\n        +incrementarTentativa() void\n        +expirou() Boolean\n    }\n\n    class Endereco {\n        &lt;&lt;entity&gt;&gt;\n        -logradouro: String\n        -numero: String\n        -bairro: String\n        -cep: String\n        -cidade: String\n        -complemento: String\n        +validarCEP() Boolean\n    }\n\n    class PreferenciaAlimentar {\n        &lt;&lt;entity&gt;&gt;\n        -tipoDieta: String\n        -descricao: String\n        -restricoes: String\n        +getRestricoes() String\n    }\n\n    class PlanoAssinatura {\n        &lt;&lt;entity&gt;&gt;\n        -idPlano: Integer\n        -nome: String\n        -quantidadeRefeicoes: Integer\n        -periodicidade: String\n        -valor: Decimal\n        +getLimiteRefeicoes() Integer\n        +getValor() Decimal\n    }\n\n    class CardapioSemanal {\n        &lt;&lt;entity&gt;&gt;\n        -semanaReferencia: String\n        -dataInicio: Date\n        -dataFim: Date\n        -ativo: Boolean\n        +obterItensCardapio(tipoDieta: String) List~ItemRefeicao~\n    }\n\n    class ItemRefeicao {\n        &lt;&lt;entity&gt;&gt;\n        -idItem: Integer\n        -nome: String\n        -categoria: String\n        -tipoDieta: String\n        -disponivel: Boolean\n        +isDisponivel() Boolean\n    }\n\n    class Assinatura {\n        &lt;&lt;entity&gt;&gt;\n        -numeroProtocolo: String\n        -dataInicio: Date\n        -status: String\n        +validarLimiteRefeicoes(quantidade: Integer) Boolean\n        +setStatus(status: String) void\n        +associarPagamento(pagamento: Pagamento) void\n        +ativarAssinatura() void\n        +gerarProtocolo() String\n        +getValorTotal() Decimal\n    }\n\n    class Pedido {\n        &lt;&lt;entity&gt;&gt;\n        -numeroPedido: Integer\n        -dataPedido: Date\n        -dataPrevisaoEntrega: Date\n        -status: String\n        -valorTotal: Decimal\n        +addItem(idItem: Integer, quantidade: Integer) void\n        +setStatus(status: String) void\n        +calcularTotal() Decimal\n    }\n\n    class ItemPedido {\n        &lt;&lt;association class&gt;&gt;\n        -quantidade: Integer\n        +setQuantidade(qtd: Integer) void\n        +getQuantidade() Integer\n    }\n\n    class Pagamento {\n        &lt;&lt;entity&gt;&gt;\n        -idTransacao: String\n        -dataHora: DateTime\n        -valorPago: Decimal\n        -status: String\n        -numeroCartaoMascarado: String\n        -nomeTitular: String\n        -dataValidade: String\n        -codigoAutorizacao: String\n        +registrarAprovacao(codAutorizacao: String) void\n    }\n\n    %% --- DEPENDÊNCIAS DO CONTROLADOR (FLUXO DO CASO DE USO) ---\n    InterfaceAssinatura ..&gt; cAssinatura : aciona &gt;\n    cAssinatura ..&gt; ServicoSMS : utiliza &gt;\n    cAssinatura ..&gt; OperadoraCartaoCredito : integra &gt;\n    cAssinatura ..&gt; Collection_PlanoAssinatura : consulta &gt;\n    cAssinatura ..&gt; Assinante : manipula &gt;\n    cAssinatura ..&gt; ValidacaoSMS : instancia/valida &gt;\n    cAssinatura ..&gt; CardapioSemanal : pesquisa &gt;\n    cAssinatura ..&gt; Assinatura : coordena &gt;\n    cAssinatura ..&gt; Pedido : monta &gt;\n    cAssinatura ..&gt; Pagamento : registra &gt;\n\n    %% --- ESTRUTURA SEMÂNTICA ENTRE ENTIDADES ---\n    Assinante \&quot;1\&quot; *-- \&quot;1..*\&quot; ValidacaoSMS : valida com &gt;\n    Assinante \&quot;1\&quot; *-- \&quot;1..*\&quot; Endereco : possui &gt;\n    Assinante \&quot;1\&quot; -- \&quot;1..*\&quot; PreferenciaAlimentar : registra &gt;\n    Assinante \&quot;1\&quot; -- \&quot;0..*\&quot; Assinatura : contrata &gt;\n    \n    PlanoAssinatura \&quot;1\&quot; -- \&quot;0..*\&quot; Assinatura : rege &lt;\n    \n    CardapioSemanal \&quot;1\&quot; o-- \&quot;1..*\&quot; ItemRefeicao : agrega &gt;\n    \n    Assinatura \&quot;1\&quot; *-- \&quot;1..*\&quot; Pedido : gera &gt;\n    Assinatura \&quot;1\&quot; -- \&quot;0..1\&quot; Pagamento : liquidada por &gt;\n    \n    Pedido \&quot;1..*\&quot; -- \&quot;1..*\&quot; ItemRefeicao : contem &gt;\n    (Pedido, ItemRefeicao) .. ItemPedido\n\n    Pagamento \&quot;0..*\&quot; -- \&quot;1\&quot; OperadoraCartaoCredito : processado por &gt;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KJq2LcWtv7n3iwNpEsOA-160">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
