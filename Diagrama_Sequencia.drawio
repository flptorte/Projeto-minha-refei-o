<mxfile host="Electron">
  <diagram name="Página-1" id="nnUSHUvKVfdnJ3w2s5Ni">
    <mxGraphModel dx="2828" dy="1682" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor A as :Assinante\n    participant Tela as &lt;&lt;boundary&gt;&gt;&lt;br/&gt;:InterfaceAssinatura\n    participant Ctrl as &lt;&lt;control&gt;&gt;&lt;br/&gt;:cAssinatura\n    participant SMS as &lt;&lt;boundary&gt;&gt;&lt;br/&gt;:ServicoSMS\n    participant V as &lt;&lt;entity&gt;&gt;&lt;br/&gt;:ValidacaoSMS\n    participant Cli as &lt;&lt;entity&gt;&gt;&lt;br/&gt;:Assinante\n    participant ColP as &lt;&lt;collection&gt;&gt;&lt;br/&gt;:Planos\n    participant Card as &lt;&lt;entity&gt;&gt;&lt;br/&gt;:CardapioSemanal\n    participant Ass as &lt;&lt;entity&gt;&gt;&lt;br/&gt;:Assinatura\n    participant Ped as &lt;&lt;entity&gt;&gt;&lt;br/&gt;:Pedido\n    participant Op as &lt;&lt;boundary&gt;&gt;&lt;br/&gt;:OperadoraCartaoCredito\n    participant Pag as &lt;&lt;entity&gt;&gt;&lt;br/&gt;:Pagamento\n\n    %% Bloco 1: Validação de Celular e SMS\n    rect rgb(240, 245, 255)\n    note right of A: Autenticação OTP via SMS (Passos 1 a 4)\n    A-&gt;&gt;Tela: informarTelefone(telefone)\n    Tela-&gt;&gt;Ctrl: solicitarCodigoSMS(telefone)\n    Ctrl-&gt;&gt;Cli: buscaOuCria(telefone)\n    Ctrl--&gt;&gt;V: &lt;&lt;create&gt;&gt;(telefone, codigoGerado)\n    Ctrl-&gt;&gt;SMS: enviarSMS(telefone, codigoGerado)\n    SMS--&gt;&gt;Tela: exibeTelaCodigo()\n    \n    A-&gt;&gt;Tela: informarCodigo(codigo)\n    Tela-&gt;&gt;Ctrl: validarCodigo(codigo)\n    Ctrl-&gt;&gt;V: resultado := validar(codigo)\n    alt [código inválido]\n        V--&gt;&gt;Ctrl: false (incrementa tentativas)\n        Ctrl--&gt;&gt;Tela: exibeErro(\&quot;Código inválido\&quot;, tentativasRestantes)\n    else [código válido]\n        V--&gt;&gt;Ctrl: true\n        Ctrl--&gt;&gt;Tela: exibePlanosDisponiveis()\n    end\n    end\n\n    %% Bloco 2: Seleção de Plano e Preferências\n    rect rgb(245, 255, 245)\n    note right of A: Seleção de Plano e Preferências (Passos 5 a 9)\n    A-&gt;&gt;Tela: selecionarPlano(idPlano)\n    Tela-&gt;&gt;Ctrl: escolherPlano(idPlano)\n    Ctrl-&gt;&gt;ColP: plano := getPlano(idPlano)\n    Ctrl--&gt;&gt;Ass: &lt;&lt;create&gt;&gt;(Cli, plano)\n    \n    A-&gt;&gt;Tela: informarPreferencias(tipoDieta)\n    Tela-&gt;&gt;Ctrl: registrarPreferencias(tipoDieta)\n    Ctrl-&gt;&gt;Cli: setPreferenciaAlimentar(tipoDieta)\n    Ctrl-&gt;&gt;Card: itensFiltrados := obterItensCardapio(tipoDieta)\n    Card--&gt;&gt;Tela: exibeCardapio(itensFiltrados)\n    end\n\n    %% Bloco 3: Montagem das Marmitas\n    rect rgb(255, 250, 240)\n    note right of A: Seleção de Refeições e Carrinho (Passos 10 a 19)\n    Ctrl--&gt;&gt;Ped: &lt;&lt;create&gt;&gt;(Ass)\n    loop [enquanto houver itens para selecionar]\n        A-&gt;&gt;Tela: selecionarItem(idItem, quantidade)\n        Tela-&gt;&gt;Ctrl: adicionarItem(idItem, quantidade)\n        Ctrl-&gt;&gt;Ass: limiteOk := validarLimiteRefeicoes(quantidade)\n        alt [quantidade &gt; cota do plano (FA2)]\n            Ctrl--&gt;&gt;Tela: exibeAlertaLimiteExcedido()\n        else [quantidade dentro da cota]\n            Ctrl-&gt;&gt;Ped: addItem(idItem, quantidade)\n            Ped--&gt;&gt;Tela: atualizaResumoPedido()\n        end\n    end\n    end\n\n    %% Bloco 4: Endereço e Checkout\n    rect rgb(255, 245, 245)\n    note right of A: Endereço e Gateway de Pagamento (Passos 20 a 32)\n    A-&gt;&gt;Tela: confirmarEndereco(dadosEndereco)\n    Tela-&gt;&gt;Ctrl: registrarEnderecoEntrega(dadosEndereco)\n    Ctrl-&gt;&gt;Cli: setEndereco(dadosEndereco)\n    Ctrl-&gt;&gt;Ass: setStatus(\&quot;Aguardando Pagamento\&quot;)\n    \n    A-&gt;&gt;Tela: informarDadosCartao(dadosCartao)\n    Tela-&gt;&gt;Ctrl: finalizarAssinatura(dadosCartao)\n    Ctrl-&gt;&gt;Ass: valorTotal := getValorTotal()\n    Ctrl-&gt;&gt;Op: autorizacao := solicitarAutorizacao(dadosCartao, valorTotal)\n    alt [pagamento recusado (FA3)]\n        Op--&gt;&gt;Ctrl: recusado(motivo)\n        Ctrl--&gt;&gt;Tela: exibeErroPagamento(\&quot;Cartão recusado. Tente outro.\&quot;)\n    else [pagamento autorizado]\n        Op--&gt;&gt;Ctrl: aprovado(codAutorizacao)\n        Ctrl--&gt;&gt;Pag: &lt;&lt;create&gt;&gt;(valorTotal, codAutorizacao, dadosCartao)\n        Ctrl-&gt;&gt;Ass: associarPagamento(Pag)\n        Ctrl-&gt;&gt;Ass: ativarAssinatura()\n        Ctrl-&gt;&gt;Ass: protocolo := gerarProtocolo()\n        Ctrl-&gt;&gt;Ped: setStatus(\&quot;Aprovado\&quot;)\n        Ctrl--&gt;&gt;Tela: exibeConfirmacao(protocolo, dataPrimeiraEntrega)\n    end\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2LlVSDLYCMv-VupCNVob-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
