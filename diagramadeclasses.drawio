        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class Assinante {\n        -telefone: String\n        -nome: String\n        -email: String\n    }\n\n    class ValidacaoSMS {\n        -codigo: String\n        -dataHoraEnvio: DateTime\n        -dataHoraExpiracao: DateTime\n        -quantidadeTentativas: Integer\n        -validado: Boolean\n    }\n\n    class Endereco {\n        -logradouro: String\n        -numero: String\n        -bairro: String\n        -cep: String\n        -cidade: String\n        -complemento: String\n    }\n\n    class PreferenciaAlimentar {\n        -tipo: String\n        -descricao: String\n        -restricoes: String\n    }\n\n    class PlanoAssinatura {\n        -nome: String\n        -quantidadeRefeicoes: Integer\n        -periodicidade: String\n        -valor: Decimal\n    }\n\n    class CardapioSemanal {\n        -semanaReferencia: String\n        -dataInicio: Date\n        -dataFim: Date\n        -ativo: Boolean\n    }\n\n    class ItemRefeicao {\n        -nome: String\n        -categoria: String\n        -tipoDieta: String\n        -disponivel: Boolean\n    }\n\n    class Assinatura {\n        -numeroProtocolo: String\n        -dataInicio: Date\n        -status: String\n    }\n\n    class Pedido {\n        -numeroPedido: Integer\n        -dataPedido: Date\n        -dataPrevisaoEntrega: Date\n        -status: String\n        -valorTotal: Decimal\n    }\n\n    class ItemPedido {\n        &lt;&lt;association class&gt;&gt;\n        -quantidade: Integer\n    }\n\n    class Pagamento {\n        -idTransacao: String\n        -dataHora: DateTime\n        -valorPago: Decimal\n        -status: String\n        -numeroCartaoMascarado: String\n        -nomeTitular: String\n        -dataValidade: String\n        -codigoAutorizacao: String\n    }\n\n    class OperadoraCartaoCredito {\n        -codigoGateway: String\n        -nomeOperadora: String\n    }\n\n    %% Relacionamentos Formais UML\n    Assinante \&quot;1\&quot; *-- \&quot;1..*\&quot; ValidacaoSMS : valida com &gt;\n    Assinante \&quot;1\&quot; *-- \&quot;1..*\&quot; Endereco : possui &gt;\n    Assinante \&quot;1\&quot; -- \&quot;1..*\&quot; PreferenciaAlimentar : registra &gt;\n    Assinante \&quot;1\&quot; -- \&quot;0..*\&quot; Assinatura : contrata &gt;\n    \n    PlanoAssinatura \&quot;1\&quot; -- \&quot;0..*\&quot; Assinatura : rege &lt;\n    \n    CardapioSemanal \&quot;1\&quot; o-- \&quot;1..*\&quot; ItemRefeicao : agrega &gt;\n    \n    Assinatura \&quot;1\&quot; *-- \&quot;1..*\&quot; Pedido : gera &gt;\n    Assinatura \&quot;1\&quot; -- \&quot;0..1\&quot; Pagamento : liquidada por &gt;\n    \n    Pedido \&quot;1..*\&quot; -- \&quot;1..*\&quot; ItemRefeicao : contem &gt;\n    (Pedido, ItemRefeicao) .. ItemPedido\n    \n    Pagamento \&quot;0..*\&quot; -- \&quot;1\&quot; OperadoraCartaoCredito : processado por &gt;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5tfZqIS0UrAjB_EjSN7e-1">
