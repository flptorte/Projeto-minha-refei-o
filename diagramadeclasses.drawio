        <mxCell id="xDtABufmuJsJCCtB00fp-62" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 36px;&quot;&gt;Diagrama de Classes - Projeto Minha Refeição&lt;/font&gt;" vertex="1">
